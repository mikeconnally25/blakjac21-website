PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret

# Local
KICK_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Your Kick user ID (not channel ID). For blakjac21: 285545
KICK_BROADCASTER_USER_ID=285545

# Production: set in Vercel dashboard after deploy
# KICK_REDIRECT_URI=https://your-project.vercel.app/api/auth/callback

# Stake API token for loading slot catalogs (stake.com → Settings → Security → API Tokens)
STAKE_ACCESS_TOKEN=

# Comma-separated Kick usernames that receive the admin badge
ADMIN_KICK_USERNAMES=blakjac21

# Optional: persist Guess the Balance toggle on Vercel via GitHub API
# GITHUB_TOKEN=your_github_personal_access_token
# GITHUB_REPO=mikeconnally25/blakjac21-website

# Recommended on Vercel: link Upstash Redis in the Vercel dashboard.
# These are added automatically when Redis is connected:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=