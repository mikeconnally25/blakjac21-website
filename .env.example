PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret

# Local
KICK_REDIRECT_URI=http://localhost:3000/api/auth/callback

